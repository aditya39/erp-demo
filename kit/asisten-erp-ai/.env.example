# Salin file ini menjadi .env lalu sesuaikan.  JANGAN commit file .env (bisa berisi API key).
#
# MODE PRAKTIK — pilih satu:
#   (a) Laptop sendiri : database Docker + Ollama di laptop ini. Nilai di bawah sudah untuk mode ini.
#   (b) Server bersama : database, model, dan ERP di laptop mentor; laptop peserta cukup Python + kode ini.
#   (c) Cadangan cloud : model chat Claude Haiku lewat API key dari mentor; embedding tetap di Ollama.
# Untuk (b) atau (c): hapus tanda "#" pada baris profil di BAGIAN BAWAH file ini (nilai di bawah menimpa
# nilai di atas). Periksa hasilnya: python scripts/cek_setup.py  (baris "Mode praktik").

# --- Database ------------------------------------------------------------
# Koneksi asisten: role read-only (hanya membaca view schema "ai", "rag", dan koleksi "latihan")
DATABASE_URL=postgresql://erp_ai_readonly:baca_saja@localhost:5433/erp
# Koneksi admin: hanya untuk ingest indeks dokumen bersama (python -m asisten.rag ingest)
DATABASE_URL_ADMIN=postgresql://erp_admin:admin_workshop@localhost:5433/erp
# Koneksi peserta: hanya bisa membuat tabel di schema "latihan" (ingest --koleksi, Sesi 2.4).
# Kosong = memakai DATABASE_URL_ADMIN (mode laptop sendiri).
DATABASE_URL_PESERTA=

# --- Model lokal (Ollama) -------------------------------------------------
LOKAL_BASE_URL=http://localhost:11434/v1
LOKAL_MODEL=qwen3:8b
# Ollama tidak memeriksa API key; diisi hanya untuk endpoint yang memerlukannya (profil c).
LOKAL_API_KEY=ollama
# "none" mematikan mode berpikir Qwen3 (jauh lebih cepat). Kosongkan untuk model lain bila error.
LOKAL_REASONING_EFFORT=none
# Temperature model chat (nama lama: SUHU). Kosong = tidak dikirim (wajib untuk model Claude, lihat profil c).
LOKAL_SUHU=0.2

# Model embedding untuk RAG (selalu Ollama: isi dokumen tidak dikirim ke penyedia cloud).
EMBED_MODEL=bge-m3
# Kosong = sama dengan LOKAL_BASE_URL. WAJIB diisi pada profil (c).
# EMBED_BASE_URL=http://localhost:11434/v1
# Kunci untuk endpoint embedding (default "ollama"); LOKAL_API_KEY tidak pernah dikirim ke endpoint ini.
# EMBED_API_KEY=ollama

# Koleksi dokumen milik Anda yang ikut dicari tool cari_dokumen (Sesi 2.4), mis. andi -> latihan.dokumen_andi.
# Isi setelah: python -m asisten.rag ingest --koleksi andi
RAG_KOLEKSI=

# --- Aplikasi ERP (Latihan 7: simulasi & simpan sales order lewat API ERP dengan login user) ---
ERP_URL=http://localhost:8080
ERP_PASSWORD=demo123

# --- Model cloud (opsional, untuk tombol Cloud & perbandingan) -----------
# Pilihan 1 (default): Claude Code yang sudah login dengan langganan Claude Anda.
#   Tidak perlu API key. Syarat: perintah `claude` terpasang dan sudah /login.
#   Model: alias Claude Code (sonnet / opus / haiku) atau nama model lengkap.
CLOUD_PENYEDIA=claude-code
CLOUD_MODEL=sonnet
#
# Pilihan 2: endpoint apa pun yang kompatibel dengan OpenAI Chat Completions + API key.
#   CLOUD_PENYEDIA=api
#   Contoh Anthropic (Claude API), sama dengan Tantangan B dan Demo 3 (lokal vs cloud) di ERP:
#     CLOUD_BASE_URL=https://api.anthropic.com/v1/
#     CLOUD_MODEL=claude-haiku-5-5
#     CLOUD_API_KEY=<API key>
#     CLOUD_SUHU=
#     (CLOUD_SUHU kosong: model Claude terbaru menolak temperature di bawah 1)
#   Contoh OpenRouter (satu akun untuk banyak penyedia, termasuk Kimi):
#     CLOUD_BASE_URL=https://openrouter.ai/api/v1
#     CLOUD_MODEL=<nama model di openrouter>
CLOUD_BASE_URL=
CLOUD_API_KEY=
CLOUD_REASONING_EFFORT=
# Temperature model cloud; kosong = tidak dikirim.
CLOUD_SUHU=

# --- Lain-lain -----------------------------------------------------------
MAKS_LANGKAH=6
# 1 = setiap percakapan di aplikasi web direkam ke folder rekaman/ (cadangan demo)
REKAM=1


# =========================================================================
# PROFIL (b) SERVER BERSAMA — laptop mentor di jaringan Wi-Fi yang sama
# Ganti 192.168.1.20 dengan IP dari mentor (scripts/server_bersama.sh mencetak blok siap tempel).
# Peserta tidak mendapat koneksi admin: indeks dokumen bersama dan data ERP tidak bisa diubah.
# =========================================================================
# DATABASE_URL=postgresql://erp_ai_readonly:baca_saja@192.168.1.20:5433/erp
# DATABASE_URL_PESERTA=postgresql://erp_peserta:latihan_rag@192.168.1.20:5433/erp
# LOKAL_BASE_URL=http://192.168.1.20:11434/v1
# EMBED_BASE_URL=http://192.168.1.20:11434/v1
# ERP_URL=http://192.168.1.20:8080


# =========================================================================
# PROFIL (c) CADANGAN CLOUD — Claude Haiku 5.5 lewat API key kelompok dari mentor
# - Pertanyaan, hasil query tool, dan potongan dokumen DIKIRIM ke Anthropic. Di kit ini semuanya data
#   dummy; untuk data klien sungguhan, mode ini butuh persetujuan pemilik data.
# - API key kelompok punya batas biaya dan dicabut setelah workshop. Jangan dibagikan atau di-commit.
# - Nama variabel tetap LOKAL_*: latihan 01–04 dan "python -m asisten" memakai profil ini apa adanya.
# - Anthropic tidak menyediakan endpoint embedding: EMBED_BASE_URL WAJIB menunjuk ke Ollama
#   (server mentor, atau http://localhost:11434/v1 bila bge-m3 ada di laptop Anda).
# - Database & ERP tetap seperti profil (b) atau (a).
# =========================================================================
# LOKAL_BASE_URL=https://api.anthropic.com/v1/
# LOKAL_MODEL=claude-haiku-5-5
# LOKAL_API_KEY=<API key kelompok dari mentor>
# LOKAL_REASONING_EFFORT=
# Kosong = temperature tidak dikirim: Claude 4.7 ke atas (termasuk Haiku 5.5) menolak temperature < 1 (error 400).
# LOKAL_SUHU=
# EMBED_BASE_URL=http://192.168.1.20:11434/v1
